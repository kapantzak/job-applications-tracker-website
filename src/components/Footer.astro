---
import { LINKS, sections } from '../content/site';

const links = [
  { href: LINKS.github, label: sections.footer.github },
  { href: LINKS.npm, label: sections.footer.npm },
  { href: LINKS.readme, label: sections.footer.readme },
  { href: LINKS.license, label: sections.footer.license },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
  >
    <div class="flex items-center gap-2.5">
      <img src="/favicon.svg" alt="" width="20" height="20" class="size-5" />
      <span>{sections.brand}</span>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
