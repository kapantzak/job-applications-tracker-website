---
import { LINKS, sections } from '../content/site';
import Icon from './Icon.astro';
---

<header class="border-b border-border">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 items-center gap-2.5 font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="28" height="28" class="size-7 shrink-0" />
      <span class="truncate">{sections.brand}</span>
    </a>
    <a
      href={LINKS.github}
      class="inline-flex shrink-0 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <Icon name="github" class="size-4" />
      {sections.header.github}
    </a>
  </div>
</header>
