---
import { INSTALL_NPX, LINKS, hero, sections } from '../content/site';
import CopyCommand from './CopyCommand';
import Icon from './Icon.astro';
---

<section id="hero" class="mx-auto w-full max-w-6xl px-4 pt-14 pb-16 sm:px-6 sm:pt-24 sm:pb-24 lg:px-8">
  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">{hero.headline}</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground sm:text-xl">{hero.subhead}</p>
    <div class="mt-10 flex flex-col items-center gap-4">
      <CopyCommand client:load command={INSTALL_NPX} location="hero" />
      <p class="text-sm text-muted-foreground">{sections.hero.requirements}</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={LINKS.github}
          class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-muted"
        >
          <Icon name="github" class="size-4" />
          {sections.hero.github}
        </a>
        <a
          href={LINKS.npm}
          class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-muted"
        >
          {sections.hero.npm}
          <Icon name="external-link" class="size-3.5" />
        </a>
      </div>
    </div>
  </div>
</section>
