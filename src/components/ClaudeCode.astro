---
import { claudeCode } from '../content/site';
---

<section id="claude-code" aria-labelledby="claude-code-title" class="border-y border-border bg-muted/40">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-2xl">
      <h2 id="claude-code-title" class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        {claudeCode.title}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">{claudeCode.intro}</p>
    </div>
    <ol class="mt-10 grid gap-4 md:grid-cols-2">
      {
        claudeCode.steps.map((step, i) => (
          <li class="flex flex-col rounded-xl border border-border bg-card p-6 text-card-foreground">
            <div class="flex items-center gap-3">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="text-lg font-semibold tracking-tight">{step.title}</h3>
            </div>
            <p class="mt-3 text-muted-foreground">{step.body}</p>
            {step.command && (
              <div class="mt-5 flex max-w-full items-center gap-3 self-start rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-sm">
                <span class="text-muted-foreground select-none" aria-hidden="true">
                  $
                </span>
                <code>{step.command}</code>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
