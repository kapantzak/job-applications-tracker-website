---
import { sections, trustPoints } from '../content/site';
import Icon from './Icon.astro';

// One icon per trust point, in trustPoints order.
const icons = ['database', 'square-terminal', 'list-checks', 'shield-check'] as const;
---

<section id="trust" aria-labelledby="trust-title" class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="max-w-2xl">
    <h2 id="trust-title" class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{sections.trust.title}</h2>
    <p class="mt-4 text-lg text-muted-foreground">{sections.trust.intro}</p>
  </div>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      trustPoints.map((point, i) => (
        <li class="rounded-xl border border-border bg-card p-6 text-card-foreground">
          <div class="flex size-10 items-center justify-center rounded-lg bg-muted">
            <Icon name={icons[i] ?? 'shield-check'} class="size-5" />
          </div>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">{point.title}</h3>
          <p class="mt-2 text-muted-foreground">{point.body}</p>
        </li>
      ))
    }
  </ul>
</section>
