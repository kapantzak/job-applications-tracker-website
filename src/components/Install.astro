---
import { INSTALL_GLOBAL, INSTALL_NPX, LINKS, RUN_GLOBAL, faq, sections } from '../content/site';
import Icon from './Icon.astro';

const copy = sections.install;
---

<section id="install" aria-labelledby="install-title" class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="max-w-2xl">
    <h2 id="install-title" class="text-3xl font-bold tracking-tight sm:text-4xl">{copy.title}</h2>
    <p class="mt-4 text-lg text-muted-foreground">{copy.intro}</p>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-border bg-card p-6 text-card-foreground">
      <h3 class="text-sm font-medium text-muted-foreground">{copy.npxLabel}</h3>
      <div class="mt-3 flex max-w-full items-center gap-3 rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-sm">
        <span class="text-muted-foreground select-none" aria-hidden="true">$</span>
        <code>{INSTALL_NPX}</code>
      </div>
    </div>
    <div class="rounded-xl border border-border bg-card p-6 text-card-foreground">
      <h3 class="text-sm font-medium text-muted-foreground">{copy.globalLabel}</h3>
      <div class="mt-3 flex flex-col gap-1.5 rounded-lg border border-border bg-background px-4 py-2.5 font-mono text-sm">
        <div class="flex items-center gap-3">
          <span class="text-muted-foreground select-none" aria-hidden="true">$</span>
          <code>{INSTALL_GLOBAL}</code>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-muted-foreground select-none" aria-hidden="true">$</span>
          <code>{RUN_GLOBAL}</code>
        </div>
      </div>
    </div>
  </div>

  <ul class="mt-6 space-y-1 text-muted-foreground">
    <li>{copy.requirements}</li>
    <li>{copy.startsOn}</li>
  </ul>

  <div class="mt-16 max-w-3xl">
    <h3 class="text-2xl font-bold tracking-tight">{sections.faq.title}</h3>
    <div class="mt-6 space-y-3">
      {
        faq.map((item) => (
          <details class="group rounded-xl border border-border bg-card text-card-foreground">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-5 py-4 font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <Icon
                name="chevron-down"
                class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180 motion-reduce:transition-none"
              />
            </summary>
            <p class="px-5 pb-5 text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted-foreground">
      <a href={LINKS.readme} class="inline-flex items-center gap-1.5 font-medium text-foreground underline-offset-4 hover:underline">
        {sections.footer.readme}
        <Icon name="external-link" class="size-3.5" />
      </a>
    </p>
  </div>
</section>
