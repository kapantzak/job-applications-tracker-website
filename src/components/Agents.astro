---
import { agents } from '../content/site';
import CopyCommand from './CopyCommand';
---

<section id="agents" aria-labelledby="agents-title" class="border-y border-border bg-muted/40">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-2xl">
      <h2 id="agents-title" class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        {agents.title}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">{agents.intro}</p>
    </div>
    {/* The first card is wide enough to keep the install command on one line. */}
    <ol class="mt-10 grid gap-4 lg:grid-cols-[minmax(25.5rem,1.3fr)_1fr_1fr]">
      {
        agents.steps.map((step, i) => (
          <li class="flex flex-col rounded-xl border border-border bg-card p-6 text-card-foreground">
            <div class="flex items-center gap-3">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="text-lg font-semibold tracking-tight">{step.title}</h3>
            </div>
            <p class="mt-3 text-muted-foreground">{step.body}</p>
            {step.command && (
              <div class="mt-5 self-start">
                <CopyCommand client:visible command={step.command} location="claude-code" />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
